<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyTitle>PawnEditorForked</AssemblyTitle>
    <Description>A mod for RimWorld that allows you to edit pawns.</Description>
    <Company>SegasWolf</Company>
    <Product>PawnEditorForked</Product>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <Nullable>disable</Nullable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS8625;CS8618;CS8600;CS8601;CS8602;CS8603;CA1305;CA1304;CA1311;CA1806;CA1822;CA1707;CA1852;CA2211;CA1805</NoWarn>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>..\..\1.6\Assemblies</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <OutputPath>..\..\1.6\Assemblies</OutputPath>
    <DefineConstants></DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer">
      <Version>2.3.0</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Krafs.Rimworld.Ref">
      <Version>1.6.4489-beta</Version>
    </PackageReference>

    <PackageReference Include="Lib.Harmony">
      <Version>2.3.3</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Polyfills de C# moderno (records, init, required...) generados en compilación: no agrega DLLs al mod. -->
    <PackageReference Include="PolySharp">
      <Version>1.16.0</Version>
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Utils\RimUI\ReadMe.txt" />
  </ItemGroup>
  <!-- La versión del DLL sale de About.xml (modVersion): una sola fuente de verdad. -->
  <Target Name="ReadModVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\..\About\About.xml" Query="/ModMetaData/modVersion/text()">
      <Output TaskParameter="Result" PropertyName="ModVersion" />
    </XmlPeek>
    <PropertyGroup>
      <AssemblyVersion>$(ModVersion)</AssemblyVersion>
      <FileVersion>$(ModVersion)</FileVersion>
      <InformationalVersion>$(ModVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>