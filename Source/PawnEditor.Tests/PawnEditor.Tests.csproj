<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de la lógica pura del mod. No referencia el DLL del mod: enlaza los archivos que prueba
    (ItemGroup de Compile al final), así no arrastra el Assembly-CSharp publicizado.

    No usa Krafs.Rimworld.Ref porque son ensamblados de solo referencia y no se pueden ejecutar.
    Usa el Unity REAL de la instalación del juego, y según lo que encuentre prueba una versión u otra:
      - RimWorld 1.6 (Unity):   net472  contra RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll
      - RimWorld 1.7 (Waylith): net10.0 contra UnityStubs.dll, en la raíz del juego
    Si encuentra los dos, corre las pruebas en ambos.

    Rutas: por defecto, la instalación de Steam. Para otra ruta (o una copia guardada de la carpeta
    Managed de 1.6), crea PawnEditor.Tests.csproj.user junto a este archivo:
        <Project><PropertyGroup>
          <RimWorldDir>D:\Steam\...\RimWorld</RimWorldDir>
          <RimWorldManagedDir>C:\Git\RimWorld-1.6-Managed</RimWorldManagedDir>
        </PropertyGroup></Project>

    Ejecutar con:  dotnet test Source\PawnEditor.Tests
  -->

  <PropertyGroup>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">$(RimWorldDir)\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <HasRimWorld16 Condition="Exists('$(RimWorldManagedDir)\UnityEngine.CoreModule.dll')">true</HasRimWorld16>
    <HasRimWorld17 Condition="Exists('$(RimWorldDir)\UnityStubs.dll')">true</HasRimWorld17>

    <TargetFrameworks Condition="'$(HasRimWorld16)' == 'true' And '$(HasRimWorld17)' == 'true'">net472;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == '' And '$(HasRimWorld17)' == 'true'">net10.0</TargetFrameworks>
    <!-- Solo 1.6, o nada encontrado (CheckRimWorldPath da el error claro). -->
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net472</TargetFrameworks>

    <AssemblyName>PawnEditor.Tests</AssemblyName>
    <RootNamespace>PawnEditor.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <Target Name="CheckRimWorldPath" BeforeTargets="BeforeBuild">
    <Error Condition="'$(HasRimWorld16)' != 'true' And '$(HasRimWorld17)' != 'true'"
           Text="No se encontró el Unity de RimWorld 1.6 ('$(RimWorldManagedDir)\UnityEngine.CoreModule.dll') ni el de 1.7 ('$(RimWorldDir)\UnityStubs.dll'). Pasa la ruta con -p:RimWorldDir=... o -p:RimWorldManagedDir=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

  <!-- Ensamblados REALES, no de referencia: Rect y Mathf tienen que poder ejecutarse. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PawnEditorForked\Utils\Layout.cs" Link="Linked\Layout.cs" />
    <Compile Include="..\PawnEditorForked\Utils\Utilities.cs" Link="Linked\Utilities.cs" />
    <Compile Include="..\PawnEditorForked\Utils\SavedXenotypeFile.cs" Link="Linked\SavedXenotypeFile.cs" />
    <Compile Include="..\PawnEditorForked\Utils\Motion\Easing.cs" Link="Linked\Easing.cs" />
    <Compile Include="..\PawnEditorForked\Utils\Motion\AnimatedFloat.cs" Link="Linked\AnimatedFloat.cs" />
    <Compile Include="..\PawnEditorForked\Utils\BottomButtonRow.cs" Link="Linked\BottomButtonRow.cs" />
  </ItemGroup>

</Project>
